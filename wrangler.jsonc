{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Cloudflare 后台显示的 Worker 名称。
  // 朋友复制网站时，建议改成不同名称，例如 peptivanta-net。
  "name": "peptivanta-biosciences",

  // Cloudflare Workers 运行兼容日期。正常修改网站内容时无需改动。
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./worker/index.ts",

  // 静态图片、字体和前端文件由 ASSETS 绑定提供给 Worker。
  // 最终的 assets.directory 会由 Cloudflare Vite 插件在构建时自动生成。
  "assets": {
    "binding": "ASSETS",

    // Cloudflare normally serves matching static files before the Worker.
    // Route only protected COA and factory media through the Worker so the
    // anti-hotlink checks run without billing every ordinary static asset.
    "run_worker_first": [
      "/coa/reports/*",
      "/media/*"
    ]
  },

  // 成交/履约记录使用的 Cloudflare D1 数据库。
  // database_id 属于当前 peptivanta.com 的 Cloudflare 账户。
  // 朋友部署 peptivanta.net 时，必须先在他自己的 Cloudflare 创建新 D1，
  // 然后替换下面的 database_name 和 database_id，不能共用此数据库。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peptivanta-production",
      "database_id": "25d0b424-5766-470a-9236-ac6b57df7b97",
      "migrations_dir": "drizzle"
    }
  ],

  // 反馈素材使用独立 R2；朋友部署副本站时请改成自己账号中的 bucket 名称。
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "peptivanta-feedback-media"
    }
  ],

  // 每日生成少量示例反馈，并清理超过 180 天的反馈素材。
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Next/Image 图片清晰度优化使用的 Cloudflare Images 运行时绑定。
  "images": {
    "binding": "IMAGES"
  },

  // 保留基础运行日志，方便排查线上错误。
  "observability": {
    "enabled": true
  }
}
